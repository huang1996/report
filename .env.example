# ==========================================================
#            巡检周报生成器 —— 环境变量配置模板
# ==========================================================
# 使用方法：复制本文件为 .env，按实际环境填写后即可用
#           docker compose（env_file: .env）启动。
#
# 通用规则：
#   1. 所有环境变量都有等价的命令参数（同名小写，如 N9E_DS_ID ↔ -n9e_ds_id），
#      参数显式传入时优先于环境变量；
#   2. 未配置的项使用内置默认值（见各项注释）；
#   3. 涉及地址 / 密码的敏感信息只放在 .env（已在 .gitignore / .dockerignore 中排除）。
# ==========================================================

# ----------------------------------------------------------
# 一、监控数据源（资源巡检）
#     影响：第 2~4 章资源水位分析、巡检明细
# ----------------------------------------------------------

# 时序库接入模式：
#   n9e       —— 经夜莺代理接口查询（默认，适用于能连中心 n9e 的机房）
#   vm        —— 直连 VictoriaMetrics 单机（适用于不具备连接中心条件的隔离机房）
#   vmcluster —— 直连 VictoriaMetrics 集群版 vmselect（N9E_DS_ID 即租户 accountID）
# 隔离机房的典型组合：categraf 把指标 remote write 到本机房 VictoriaMetrics，
# 本程序直连时序库查询；详见 README「隔离机房部署」一节。
# 默认：n9e
# TSDB_MODE=n9e

# 监控服务地址，如 http://<n9e服务器IP>:17000
# TSDB_MODE=vm/vmcluster 时，此处填 VictoriaMetrics 地址，如 http://127.0.0.1:8428
# 留空则不采集资源巡检数据（报告将不含第 2~4 章数据并输出告警）
# N9E_BASE=

# 数据源 ID（一个数据源≈一个项目）；启动前可用 -list-ds 查看清单
# TSDB_MODE=vmcluster 时为租户 accountID（单租户默认 0）；TSDB_MODE=vm 时忽略此项
# 默认：1
# N9E_DS_ID=1

# 主机标识所用的标签名（报告解析 租户 / IP / 项目 / 角色 的依据）：
#   auto（默认）—— 直连时序库时自动探测：ident 优先，库里没有 ident 就回退 agent_hostname；
#                  经夜莺查询时恒用 ident，不做任何探测（行为与旧版一致）
#   ident        —— 固定用 ident
#   agent_hostname —— 固定用 agent_hostname
#   其他标签名    —— 固定用该标签（如自研采集端写入的 host）
# 说明：夜莺的 ident 是 pushgw 把 categraf 的 agent_hostname 就地改名而来的；
#       隔离机房是 categraf 直写时序库，没有这层改写，自动回退让「categraf 什么都不配」
#       也能正常出报告（两者的值本来就是同一个）。用 -list-ds 可查看实际生效的标签。
# 默认：auto
# N9E_HOST_LABEL=auto

# 项目名关键字：
#   ① ident 中包含该关键字的主机才纳入统计；
#   ② 未指定 N9E_DS_ID 时按它在全部数据源中自动检索（直连 VictoriaMetrics 时
#      没有数据源概念，只用 ① 按 ident 过滤）
# N9E_PROJECT=某业务平台

# n9e 认证信息（本实例代理接口免认证时可全部留空）
# 三种方式任选：仅 TOKEN / 仅 USER+PASS / 全部留空（免认证）
# N9E_TOKEN=
# N9E_USER=
# N9E_PASS=

# ident 末尾段判定：auto / always / never（默认 auto）
# 【已弃用】运维工程师现在只认 REPORT_ENGINEER，本项传非 auto 值会 WARN 并被忽略。
# N9E_IDENT_ENGINEER_TAIL=auto

# 按 N9E_PROJECT 自动检索数据源时的最大编号
# 默认：90
# N9E_MAX_DS=90

# n9e 请求重试：夜莺经网关访问偶发 502 / 响应头超时（服务端瞬时不可用，稍后重试即可），
# 而单次失败会让整份报告缺失资源巡检数据，因此对「瞬时错误」按指数退避自动重试。
#   · 可重试：5xx（含 502）、429 限流、408 超时、连接被重置 / 超时、200 但正文非 JSON；
#   · 不重试：400 查询语法错误、401/403 鉴权、404 路由不存在（重试无意义）。
# N9E_RETRY 为总尝试次数（含首次），1=不重试；N9E_RETRY_BACKOFF 为首次退避秒数，
# 之后按 2 倍递增，单次上限 30s。
# 默认：N9E_RETRY=4，N9E_RETRY_BACKOFF=3（即最多尝试 4 次，退避约 3s+6s+12s）
# N9E_RETRY=4
# N9E_RETRY_BACKOFF=3

# ----------------------------------------------------------
# 二、Safeline WAF 雷池数据库（安全巡检数据源）
#     影响：WAF 安全巡检章节（防护应用概览 / 访问统计 / 攻击统计 / 未拦截明细）
# ----------------------------------------------------------

# 雷池 PostgreSQL 连接串
# 留空则跳过 WAF 章节；与 safeline-ce compose 同网络时可写服务名
# 密码含特殊字符时建议用 query 形式：
#   postgresql://<主机>/<库名>?user=<用户>&password=<密码>&sslmode=disable
# WAF_DATABASE_URL=postgresql://safeline-pg/safeline-ce?user=safeline-ce&password=changeme&sslmode=disable

# 需要排除的 WAF 应用 ID，逗号分隔（如 3,5）
# WAF_EXCEPT_APP_IDS=

# 需要排除的 WAF 访问来源 IP，逗号分隔（如 218.88.215.93,10.0.0.1）
# WAF_EXCEPT_IPS=

# ----------------------------------------------------------
# 三、报告输出
#     影响：报告名称、内容章节、输出位置
# ----------------------------------------------------------

# 报告输出目录（容器内路径，compose 中通过 volumes 挂载到宿主机）
# 默认：/app/report
# REPORT_DIR=/app/report

# 自定义报告名称；留空则按单一业务系统自动生成「XX巡检周报」，
# 多系统时兜底为「云资源巡检周报」
# REPORT_NAME=某业务平台巡检周报

# 运维工程师姓名，一处配置三处生效：
#   ① 覆盖各主机的运维工程师字段
#   ② 报告信息表中的工程师
#   ③ WebDAV 上传目录名 report/<工程师>/<yyyymmdd>/
# 留空时上传目录为 report/default/ 并输出告警日志
# REPORT_ENGINEER=张三

# 是否添加「业务巡检」章节（1 或 true 开启；默认不添加）
# 该章节默认留空，供人工填写
# REPORT_INCLUDE_BIZ=

# 统计周期内 n9e 无数据时，按数据源最新数据随机增减伪造资源巡检指标
#   · 仅作用于 n9e 资源巡检指标，WAF 章节不受影响；
#   · 基准取该数据源最近 1 小时数据，仅保存在内存中（不写入磁盘）；
#   · 伪造数值不可用于真实结论，日志会以 WARN 提示（报告正文不做标注）。
# 默认关闭：周期内无数据时直接跳过，不生成报告
# REPORT_FAKE_WHEN_EMPTY=

# ----------------------------------------------------------
# 四、定时调度（常驻模式）
#     影响：docker compose 常驻运行时的触发时机与频率
# ----------------------------------------------------------

# 每日触发时刻，24 小时制 HH:MM
# 默认：12:00
# REPORT_TIME=12:00

# 报告页眉文字（显示在每页顶部，居中）
# 默认：统筹运维项目
# REPORT_HEADER=统筹运维项目

# 仅在指定星期生成报告（0=周日、1=周一 … 6=周六，逗号分隔）
# 典型场景：REPORT_RUN_WEEKDAYS=5 表示仅每周五生成
# 留空则每天生成
# REPORT_RUN_WEEKDAYS=

# ----------------------------------------------------------
# 五、WebDAV 上传（保留自 safeline-report）
#     影响：报告生成后是否上传到 WebDAV 服务器
# ----------------------------------------------------------

# WebDAV 服务地址
# 三项均配置才启用上传；不配置则只保存到本地 REPORT_DIR
# WEBDAV_HOSTNAME=https://dav.example.com/dav
# WEBDAV_LOGIN=davuser
# WEBDAV_PASSWORD=changeme

# ----------------------------------------------------------
# 六、日志
# ----------------------------------------------------------

# 日志等级：DEBUG / INFO / WARN / ERROR
# 默认：INFO
# LOG_LEVEL=INFO
